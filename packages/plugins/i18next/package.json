{
	"name": "@inlang/plugin-i18next",
	"version": "6.5.5",
	"description": "Import and export i18next JSON files in your Git repo. Add plugin.inlang.i18next with a pathPattern to project.inlang/settings.json. Also finds unused keys with inlang check.",
	"type": "module",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"./dist",
		"./assets"
	],
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/generaltranslation/inlang",
		"directory": "packages/plugins/i18next"
	},
	"scripts": {
		"dev": "node ./build.js",
		"build": "NODE_ENV=production node ./build.js",
		"test": "tsc --noEmit && vitest run",
		"test:watch": "vitest",
		"format": "prettier ./src --write",
		"clean": "rm -rf ./dist ./node_modules",
		"prepack": "node ../../../scripts/readme-frontmatter.mjs strip",
		"postpack": "node ../../../scripts/readme-frontmatter.mjs restore"
	},
	"dependencies": {
		"@babel/parser": "^7.28.5",
		"@inlang/sdk": "workspace:*",
		"@sinclair/typebox": "0.31.28"
	},
	"devDependencies": {
		"@inlang/plugin-icu1": "workspace:*",
		"@inlang/tsconfig": "workspace:*",
		"@types/flat": "^5.0.2",
		"@types/lodash.merge": "^4.6.7",
		"@types/parsimmon": "1.10.6",
		"esbuild": "^0.24.2",
		"flat": "^6.0.1",
		"i18next": "26.4.2",
		"parsimmon": "^1.18.1",
		"prettier": "^3.3.3",
		"typescript": "^5.5.2",
		"vitest": "^3.2.4"
	},
	"license": "MIT"
}
