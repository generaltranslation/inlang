{
  "name": "@inlang/plugin-apple-xcstrings",
  "version": "0.3.2",
  "description": "Import and export Xcode .xcstrings catalogs, with variables, plurals and device variations, in your Git repo. Add plugin.inlang.apple-xcstrings with a pathPattern to project.inlang/settings.json.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "files": [
    "./dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "node build.js",
    "build": "NODE_ENV=production node build.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../../scripts/readme-frontmatter.mjs strip",
    "postpack": "node ../../../scripts/readme-frontmatter.mjs restore"
  },
  "dependencies": {
    "@inlang/sdk": "workspace:*",
    "@sinclair/typebox": "^0.31.17"
  },
  "devDependencies": {
    "@inlang/tsconfig": "workspace:*",
    "esbuild": "^0.25.9",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/generaltranslation/inlang.git",
    "directory": "packages/plugins/apple-xcstrings"
  },
  "license": "MIT"
}
