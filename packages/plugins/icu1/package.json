{
  "name": "@inlang/plugin-icu1",
  "version": "1.3.10",
  "description": "Import and export ICU MessageFormat v1 JSON files in your Git repo, with selects, plurals and selectordinal. Add plugin.inlang.icu-messageformat-1 with a pathPattern to project.inlang/settings.json.",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/generaltranslation/inlang",
    "directory": "packages/plugins/icu1"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "./dist"
  ],
  "scripts": {
    "dev": "node ./build.js",
    "build": "NODE_ENV=production node ./build.js",
    "test": "tsc --noEmit && vitest run --passWithNoTests",
    "format": "prettier ./src --write",
    "clean": "rm -rf ./dist ./node_modules",
    "prepack": "node ../../../scripts/readme-frontmatter.mjs strip",
    "postpack": "node ../../../scripts/readme-frontmatter.mjs restore"
  },
  "devDependencies": {
    "@inlang/tsconfig": "workspace:*",
    "esbuild": "^0.25.9",
    "intl-messageformat": "10.7.16",
    "prettier": "3.3.3",
    "typescript": "^5.5.2",
    "vitest": "^4.0.6"
  },
  "dependencies": {
    "@messageformat/parser": "^5.1.1",
    "@inlang/sdk": "workspace:*",
    "@sinclair/typebox": "^0.31.17"
  },
  "license": "MIT"
}
