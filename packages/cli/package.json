{
  "name": "@inlang/cli",
  "version": "3.7.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/generaltranslation/inlang"
  },
  "keywords": [
    "i18n",
    "l10n",
    "translation",
    "internationalization",
    "svelte",
    "localization",
    "lint",
    "check",
    "missing-translations",
    "unused-translations",
    "ci",
    "i18next",
    "react",
    "vue",
    "angular"
  ],
  "main": "./dist/main.js",
  "type": "module",
  "bin": {
    "inlang": "./bin/run.js"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "files": [
    "/bin",
    "/dist"
  ],
  "scripts": {
    "dev": "node ./build.js",
    "build": "cross-env NODE_ENV=production node ./build.js && tsc --noEmit",
    "test": "tsc --noEmit && vitest run --coverage --test-timeout=10000",
    "test:package": "node ./scripts/test-packed-wasm-fallback.mjs",
    "test:watch": "vitest",
    "format": "prettier ./src --write",
    "clean": "rm -rf ./dist ./node_modules"
  },
  "dependencies": {
    "@inlang/sdk": "workspace:*",
    "esbuild-wasm": "^0.19.2",
    "open": "^10.2.0"
  },
  "devDependencies": {
    "@generaltranslation/api": "0.7.0-samsara.3",
    "@generaltranslation/auth": "0.1.0-samsara.0",
    "@inlang/plugin-i18next": "workspace:*",
    "@inlang/plugin-m-function-matcher": "workspace:*",
    "@inlang/plugin-message-format": "workspace:*",
    "@inlang/plugin-next-intl": "workspace:*",
    "@inlang/tsconfig": "workspace:*",
    "@sinclair/typebox": "^0.31.17",
    "@types/cli-progress": "^3.11.5",
    "@types/node": "20.5.9",
    "@types/promptly": "^3.0.2",
    "@types/prompts": "^2.4.4",
    "@vitest/coverage-v8": "2.1.8",
    "cli-progress": "^3.12.0",
    "commander": "^11.0.0",
    "consola": "^3.2.3",
    "dotenv": "^16.4.5",
    "cross-env": "^7.0.3",
    "esbuild": "^0.19.2",
    "prompts": "^2.4.2",
    "typescript": "5.2.2",
    "uuid": "^14.0.0",
    "vitest": "2.1.8"
  },
  "license": "MIT"
}
